{
  "name": "nettside-ks",
  "main": "worker.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "build": { "command": "node scripts/build-cloudflare.mjs" },
  "assets": { "directory": "./.cf-public", "binding": "ASSETS", "run_worker_first": ["/api/*"] }
}

